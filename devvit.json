{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dejapost",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["v.redd.it", "qtyvytpodaznfhffdzus.supabase.co"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "[dejapost] New Post",
        "description": "Create a new dejapost post.",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onPostSubmit": "/internal/on-post-submit",
    "onAppInstall": "/internal/on-app-install"

  },
  "scheduler": {
    "tasks": {
      "seed-fingerprints": {
        "endpoint": "/internal/scheduler/seed-fingerprints"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "dejapost_dev"
  },
  "settings": {
    "subreddit": {
      "timeThreshold":{
        "type": "select",
        "label": "Repost check window",
        "options": [
          { "label": "1 day", "value" : "1"},
          { "label": "2 day", "value" : "2"},
          { "label": "5 day", "value" : "5"}
        ],
        "helpText": "select how far back you want DejaPost to look",
        "defaultValue": "2"
      }
    }
  }
}